#!/bin/bash
#SBATCH --job-name=make_dicts
#SBATCH --output=logs/make_dicts_%A_%a.log
#SBATCH --error=logs/make_dicts_%A_%a.log
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16              # Number of CPU cores (helpful for parallel processing)
#SBATCH --mem=128G                      # Request 128 GB memory (can be modified)
#SBATCH --time=24:00:00                 # Maximum runtime, format HH:MM:SS

# If you need a module environment, put it here. For example:
# module purge
# module load anaconda/2022.05

# Activate conda environment (use your own)
source /hpc/dctrl/yy450/miniconda3/etc/profile.d/conda.sh
conda activate sepy2

# Working directory (change to your project directory)
cd ~/link_dctrl_yy450/Sepy2.0

# If you want to log node information for debugging:
echo "Running on host: $(hostname)"
echo "Job id: $SLURM_JOB_ID"
echo "Allocated CPUs: $SLURM_CPUS_ON_NODE"
echo "Allocated memory: $SLURM_MEM_PER_NODE"

# Run the script
python make_dicts.py

# Print finish time when exiting
echo "Finished at: $(date)"